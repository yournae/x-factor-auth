# X Actions — Environment Variables
# Copy this to .env and fill in your values

# === X/Twitter Cookies ===
# Get from: DevTools → Application → Cookies → x.com
X_AUTH_TOKEN=your_auth_token_here
X_CT0=your_ct0_here

# === Multi-Account Rotation (Optional) ===
# Uncomment and fill for additional accounts
# X2_AUTH_TOKEN=
# X2_CT0=
# X3_AUTH_TOKEN=
# X3_CT0=

# === CloakBrowser (Browser Mode) ===
# Only needed if using browser fallback
CLOAKBROWSER_URL=http://localhost:8080
CLOAKBROWSER_PROFILE_ID=your_profile_id_here

# === Remote VPS (Optional) ===
# SSH host for remote CloakBrowser execution
# Leave empty to disable remote fallback
REMOTE_VPS_HOST=
REMOTE_VPS_USER=root
REMOTE_VPS_KEY_PATH=~/.ssh/id_rsa

# === Rate Limits ===
MIN_DELAY_SECONDS=150
MAX_POSTS_PER_DAY=25
MAX_RETWEETS_PER_DAY=50
MAX_LIKES_PER_DAY=100
